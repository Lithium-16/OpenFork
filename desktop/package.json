{
  "name": "openfork-desktop",
  "productName": "OpenFork",
  "version": "1.0.0",
  "private": true,
  "description": "OpenFork for Windows: play on your own computer, no internet needed.",
  "author": "Lithium-16",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win --publish never",
    "dist:dir": "node build.mjs && electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.lithium16.openfork",
    "productName": "OpenFork",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/public/**"
    ],
    "extraResources": [
      {
        "from": "dist/public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "OpenFork-Setup-${version}.${ext}",
      "shortcutName": "OpenFork",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lithium-16",
        "repo": "OpenFork",
        "releaseType": "release"
      }
    ]
  }
}
